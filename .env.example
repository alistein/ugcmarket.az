# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # server only — bypasses RLS

# Production: https://ugcmarket.az (canonical host; used in auth email links).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Auth emails (codes, confirmation, reset), sent by Supabase through Resend SMTP.
# Production: 1, together with "Confirm email" ON in Supabase. Empty = test mode (Google + password only).
NEXT_PUBLIC_AUTH_EMAIL=

# Google OAuth Web client ID (Google Cloud → Google Auth Platform → Clients). Public, not a secret.
# Set → Google sign-in runs on our domain (Google Identity Services + One Tap), so Google shows
# ugcmarket.az instead of supabase.co. Empty → Supabase redirect flow. The same ID (and its secret)
# also goes into Supabase → Auth → Providers → Google, including "Authorized Client IDs".
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# PostHog (EU cloud)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Resend
RESEND_API_KEY=
EMAIL_FROM="UGCMarket <team@mail.ugcmarket.az>"

# Show /ui-kit in production builds (e.g. Vercel preview). Leave empty in prod.
NEXT_PUBLIC_SHOW_UI_KIT=

# Social stats (src/server/social). Providers are tried in order; empty = skipped.
# Instagram, official (Meta Business Discovery). Needs our IG business account + Meta app review.
IG_BUSINESS_ACCOUNT_ID=
IG_GRAPH_TOKEN=
# Instagram, TEMPORARY third-party fallback (Apify scraper) until the Meta app is reviewed.
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR=apify/instagram-profile-scraper
# YouTube Data API v3 key (Google Cloud Console). No review needed.
YOUTUBE_API_KEY=
# Vercel Cron (daily stats refresh). Any long random string; set the same value in Vercel.
CRON_SECRET=
